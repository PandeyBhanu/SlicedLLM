# Backend API base URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Only needed if the backend sets API_KEY. NOTE: NEXT_PUBLIC_* values are visible to every browser user.
NEXT_PUBLIC_API_KEY=
# Sent as X-Actor-Id and recorded in the audit trail (asserted, not authenticated)
NEXT_PUBLIC_ACTOR_ID=
