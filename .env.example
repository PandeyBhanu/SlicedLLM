# SlicedLLM API Settings
PROJECT_NAME="SlicedLLM"
ENVIRONMENT=development
API_V1_STR=/api/v1
# Dev-only placeholder. Set a real secret (and API_KEY below) in any shared environment.
SECRET_KEY=dev-only-change-me
LOG_LEVEL=INFO

# Optional shared API key. When set, every /api/* request must send header `X-API-Key`.
# Leave empty for local development.
API_KEY=
# Comma-separated allowed origins for the Next.js frontend.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL Connection Settings
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=slicedllm

# SQLAlchemy Database URL (automatically constructed from the POSTGRES_* vars if not set)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/slicedllm

# Create tables + triggers on startup (dev convenience). Set to false and use
# `alembic upgrade head` in real deployments.
AUTO_CREATE_SCHEMA=true

# Ollama Configuration (local LLM provider)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=120.0
OLLAMA_MAX_CONCURRENT_REQUESTS=10

# Groq Configuration (cloud LLM provider, OpenAI-compatible API)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com
GROQ_TIMEOUT=120.0
GROQ_MAX_CONCURRENT_REQUESTS=10

# Evaluation defaults (each run records the values it actually used in evaluation_runs.config)
EVALUATION_CASE_CONCURRENCY=4        # cases processed in parallel per run
EVALUATION_MAX_INFLIGHT_REQUESTS=8   # global cap on simultaneous LLM calls
EVALUATION_REQUESTS_PER_SECOND=0.0   # 0 = unlimited
EVALUATION_CALL_TIMEOUT=120.0        # per LLM call, seconds
EVALUATION_MAX_RETRIES=3
EVALUATION_BACKOFF_BASE=1.0
EVALUATION_MAX_CASES_PER_RUN=500
JUDGE_MAX_ATTEMPTS=3
# DEFAULT_JUDGE_PROVIDER / DEFAULT_JUDGE_MODEL default to the candidate provider/model
DEFAULT_JUDGE_PROVIDER=
DEFAULT_JUDGE_MODEL=

# Durable job runner (the evaluation_runs table is the queue)
RUN_WORKER_IN_APP=true               # false => run `python -m app.jobs` separately
JOB_POLL_INTERVAL=1.0
JOB_HEARTBEAT_INTERVAL=5.0
JOB_STALE_SECONDS=60.0               # RUNNING run with no heartbeat this long is recovered
JOB_MAX_ATTEMPTS=3                   # interruptions before a run is marked FAILED
JOB_RECOVER_ON_STARTUP=true

# Tests: a disposable database; its public schema is dropped per test session.
# TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/slicedllm_test
