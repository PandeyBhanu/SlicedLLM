# SlicedLLM API Settings
PROJECT_NAME="SlicedLLM"
ENVIRONMENT=development
API_V1_STR=/api/v1
SECRET_KEY=super-secret-development-key-change-in-production-1234567890
LOG_LEVEL=info

# PostgreSQL Connection Settings
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=slicedllm

# SQLAlchemy Database URL (automatically constructed if not explicitly set)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/slicedllm

# Optional API Keys for LLM Providers (for future extensibility)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
COHERE_API_KEY=

# Ollama Configuration (Local LLM Provider)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=120.0
OLLAMA_MAX_RETRIES=3
OLLAMA_MAX_CONCURRENT_REQUESTS=10

# Groq Configuration (Cloud LLM Provider)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com
GROQ_TIMEOUT=120.0
GROQ_MAX_RETRIES=3
GROQ_MAX_CONCURRENT_REQUESTS=10

# Evaluation Configuration
EVALUATION_MAX_CONCURRENT=10
EVALUATION_DEFAULT_TIMEOUT=120.0
EVALUATION_ENABLE_JUDGE=false
